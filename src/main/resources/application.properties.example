# Modelo de configuracao. Copie para application.properties (que fica fora do git) e ajuste.
spring.application.name=ace

# ---------- Banco de dados (PostgreSQL) ----------
# Pode ser sobrescrito pelas variaveis de ambiente DB_URL, DB_USER e DB_PASSWORD.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/ace}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=true
spring.jpa.properties.hibernate.format_sql=true

# ---------- Acesso do administrador ----------
# Troque estes valores (ou defina ADMIN_EMAIL / ADMIN_PASSWORD) antes de colocar em producao.
app.admin.email=${ADMIN_EMAIL:admin@alessandrosilva.com}
app.admin.password=${ADMIN_PASSWORD:alessandro123}
app.admin.nome=${ADMIN_NOME:Administrador}

server.servlet.session.timeout=8h
